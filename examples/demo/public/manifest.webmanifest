{
  "name": "libp2p WebRTC over QR",
  "short_name": "WebRTC QR",
  "description": "Connect two browsers directly as libp2p peers by scanning a signed WebRTC handshake as a QR code. No relay, no signaling server.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0B0E15",
  "theme_color": "#0B0E15",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
